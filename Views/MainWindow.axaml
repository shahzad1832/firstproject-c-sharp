<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:firstProject.ViewModels"
        xmlns:models="clr-namespace:firstProject.Models"
        xmlns:converters="clr-namespace:firstProject.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="firstProject.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="firstProject">

    <Window.Resources>
        <converters:PathToBitmapConverter x:Key="PathToBitmapConverter"/>
    </Window.Resources>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>
   
  <Grid RowDefinitions="Auto, Auto, *">
    
    <!-- Row 0: Current Tracking -->
    <StackPanel Grid.Row="0" Margin="10">
        <TextBlock Text="Current Window:" Foreground="Gray"/>
        <TextBlock Text="{Binding CurrentWindowTitle}" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="{Binding StatusMessage}" Foreground="DarkRed" Margin="0,6,0,0"/>
        <TextBlock Text="{Binding TodayTotalTime, StringFormat='Today: {0}'}" Foreground="DarkGreen" Margin="0,6,0,0"/>
        <TextBlock Text="{Binding IdleTotalTime, StringFormat='Idle: {0}'}" Foreground="DarkOrange" Margin="0,4,0,0"/>
    </StackPanel>

        <!-- Row 1: History Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="10">
        <Button Content="{Binding TrackingButtonText}" 
            Command="{Binding ToggleTrackingCommand}"
            HorizontalAlignment="Stretch" 
            Background="DarkGreen" Foreground="White"/>
        <Button Content="Show History" 
            Command="{Binding ShowHistoryCommand}"
            HorizontalAlignment="Stretch" 
            Background="DarkBlue" Foreground="White"/>
        <Button Content="Clear History" 
            Command="{Binding ClearHistoryCommand}"
            HorizontalAlignment="Stretch" 
            Background="DarkRed" Foreground="White"/>
        </StackPanel>

    <!-- Row 2: History List -->
    <ScrollViewer Grid.Row="2" Margin="10">
        <ItemsControl ItemsSource="{Binding HistoryItems}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:HistoryDayGroup}">
                    <Border Margin="0,0,0,12" Padding="12" CornerRadius="8" BorderBrush="#D0D0D0" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding HeaderText}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Records.Count, StringFormat='{}{0} activities'}" Foreground="Gray"/>
                            <ItemsControl ItemsSource="{Binding Records}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ActivityRecord}">
                                        <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="5" Margin="0,0,0,8">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="*, Auto, Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding AppNames}" FontWeight="Bold"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding StartTime, StringFormat='{}{0:HH:mm}'}" Margin="10,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding FormattedDuration}" Foreground="Green"/>
                                                </Grid>
                                                <Image Source="{Binding ScreenshotPath, Converter={StaticResource PathToBitmapConverter}}"
                                                       IsVisible="{Binding HasScreenshot}"
                                                       MaxWidth="640"
                                                       MaxHeight="360"
                                                       Stretch="UniformToFill"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
    
</Grid>
</Window>