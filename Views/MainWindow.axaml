<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:firstProject.ViewModels"
        xmlns:models="clr-namespace:firstProject.Models"
        xmlns:converters="clr-namespace:firstProject.Converters"
        x:Class="firstProject.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Assign In"
        Icon="avares://firstProject/Assets/assign.png"
        Width="300"
        Height="560"
        MinWidth="300"
        MinHeight="560"
        Background="#F2F2F3"
        ExtendClientAreaToDecorationsHint="False">

    <Window.Resources>
        <converters:PathToBitmapConverter x:Key="PathToBitmapConverter"/>
        <converters:ViewportToScreenshotSizeConverter x:Key="ViewportToScreenshotSizeConverter"/>

        <SolidColorBrush x:Key="PrimaryColor" Color="#0045BB"/>
        <SolidColorBrush x:Key="TealBrush" Color="#2FB7A8"/>
        <SolidColorBrush x:Key="TextBrush" Color="#333743"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#7B7E89"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#F8F8FA"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="Background" Value="#ECECEF"/>
            <Setter Property="BorderBrush" Value="#E3E1EA"/>
        </Style>

        <Style Selector="NumericUpDown">
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="Background" Value="#ECECEF"/>
            <Setter Property="BorderBrush" Value="#E3E1EA"/>
        </Style>

        <Style Selector="TabControl">
            <Setter Property="Background" Value="#F2F2F4"/>
        </Style>

        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#555866"/>
            <Setter Property="Padding" Value="18,9"/>
        </Style>

        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
        </Style>

        <Style Selector="Button.HeaderButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.HeaderButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E2DFEE"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
        </Style>
        <Style Selector="Button.CircleButton">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="19"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="white"/>
        </Style>
        <Style Selector="Button.CircleButton:disabled">
            <Setter Property="Background" Value="Gray"/>
            <Setter Property="Foreground" Value="white"/>
        </Style>
        <Style Selector="Button.CircleButton:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="gray"/>
            <Setter Property="Foreground" Value="white"/>
        </Style>
    </Window.Styles>

    <Border BorderBrush="#202020" BorderThickness="4" Background="#F2F2F4">
        <Grid RowDefinitions="31, *, 44">
            <Border Grid.Row="0" Background="#F6F6F7" BorderBrush="#E3E3E6" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="58, *, Auto" Margin="8,0">


                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                        <Grid Height="15"  Margin="0,0,4,0" >
                            <Image Source="avares://firstProject/Assets/assign.png"></Image>
                        </Grid>
                        <TextBlock Text="Assign In" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" />

                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="HeaderButton"
                                Content="↻"
                                Command="{Binding ShowHistoryCommand}"
                                ToolTip.Tip="Refresh Data"/>
                        <TextBlock Text="user"
                                   VerticalAlignment="Center"
                                   Foreground="#777A82"
                                   FontSize="9"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Row="1" Padding="0" BorderThickness="0">
                <TabItem Header="Time Tracking">
                    <Grid RowDefinitions="Auto, Auto, *">
                        <StackPanel Grid.Row="0" Margin="18,12,18,10" Spacing="10">


                            <TextBlock Text="{Binding AttendanceClockText}"
                                       FontSize="31"
                                       FontWeight="SemiBold"
                                       Foreground="#173F55"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,0"/>

                            <Grid ColumnDefinitions="Auto, Auto, *" ColumnSpacing="10" HorizontalAlignment="Center">
                                <Button Grid.Column="0"
                                        Classes="CircleButton"
                                        Content="▶"
                                        Command="{Binding ClockInCommand}"
                                        IsEnabled="{Binding !IsTracking}"/>

                                <Button Grid.Column="1"
                                        Classes="CircleButton"
                                        Content="⏸"
                                        Command="{Binding TakeBreakCommand}"
                                        IsEnabled="{Binding IsTracking}"/>

                            </Grid>
                        </StackPanel>

                        <Border Grid.Row="1" Height="1" Background="#E2E2E5"/>

                        <ScrollViewer Grid.Row="2" Margin="10,10,10,0">
                            <StackPanel Spacing="04">




                                <Grid Margin="0,0,0,8" >

                                    <TextBlock Grid.Column="0" Text="Today" Foreground="Black"/>
                                    <TextBlock   Grid.Column="2" Padding="0,0,4,0" HorizontalAlignment="Right"
                                                 Text="{Binding TodayDateText}"
                                                 Foreground="{StaticResource MutedBrush}"
                                                 />
                                </Grid>
                                <Border Background="White"
                                        BorderBrush="#D9D9DE"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="0,20">

                                    <Grid ColumnDefinitions="*,*,*,*">

                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <TextBlock Text="Clock In"

                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="9" Margin="0,0, 0,4"/>

                                            <TextBlock Text="{Binding WorkdayStart}"
                                                       FontSize="11"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    HorizontalAlignment="Center">

                                            <TextBlock Text="Clock Out"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="9" Margin="0,0,0,4"/>

                                            <TextBlock Text="{Binding WorkdayEnd}"
                                                       FontSize="11"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    HorizontalAlignment="Center">

                                            <TextBlock Text="Productive"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="9" Margin="0,0,0,4"/>

                                            <TextBlock Text="{Binding AttendanceClockText}"
                                                       FontSize="10"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3"
                                                    HorizontalAlignment="Center">

                                            <TextBlock Text="Idle Time"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="9" Margin="0,0,0,4"/>

                                            <TextBlock Text="{Binding IdleTotalTime}"
                                                       FontSize="10"/>
                                        </StackPanel>

                                    </Grid>
                                </Border>
                                <Grid RowDefinitions="Auto" ColumnDefinitions="*,*"
                                      Margin="0,10,0,0">

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Idle Time"
                                                   Foreground="Black"
                                                   />
                                    </StackPanel>


                                </Grid>
                                <StackPanel Spacing="6" IsVisible="{Binding !TodayIdleRecords.Count}">
                                    <TextBlock Text="No idle time yet" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding TodayIdleRecords}">
                                    <ItemsControl.ItemTemplate >
                                        <DataTemplate DataType="{x:Type models:ActivityRecord}">
                                            <Border Background="#F1F1F3" BorderBrush="#D9D9DE" BorderThickness="1" CornerRadius="3" Padding="12,9" Margin="0,0,0,7">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding TimeRangeText}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding IdleDurationText}" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding FormattedDuration}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Recent activity" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>

                                <ItemsControl ItemsSource="{Binding HistoryItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:HistoryDayGroup}">
                                            <StackPanel Spacing="7">
                                                <TextBlock Text="{Binding HeaderText}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                                <ItemsControl ItemsSource="{Binding Records}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type models:ActivityRecord}">
                                                            <Border Background="#F1F1F3" BorderBrush="#D9D9DE" BorderThickness="1" CornerRadius="3" Padding="12,9" Margin="0,0,0,7">
                                                                <Grid ColumnDefinitions="*, Auto">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding AppNames}" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{Binding StartTime, StringFormat='Clock in  {0:HH:mm}'}" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1" Text="{Binding FormattedDuration}" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>


                <TabItem Header="Screenshots">
                    <Grid RowDefinitions="Auto, Auto, *">

                        <!-- Header row: count + refresh -->
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="18,12,18,8">
                            <StackPanel>
                                <TextBlock Text="Today's Screenshots"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Binding ScreenshotCountText}"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="9"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="HeaderButton"
                                    Content="↻"
                                    Command="{Binding RefreshScreenshotsCommand}"
                                    ToolTip.Tip="Refresh Screenshots"
                                    FontSize="16"
                                    VerticalAlignment="Top"/>
                        </Grid>

                        <Border Grid.Row="1" Height="1" Background="#E2E2E5"/>

                        <StackPanel Grid.Row="2"
                                    IsVisible="{Binding !TodayScreenshots.Count}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Spacing="8"
                                    Margin="18">
                            <TextBlock Text="📷"
                                       FontSize="32"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="No screenshots yet"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Screenshots are captured automatically during tracking"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="9"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="2"
                                      x:Name="ScreenshotsScroll"
                                      IsVisible="{Binding TodayScreenshots.Count}"
                                      Margin="14,10,14,10">
                            <ItemsControl ItemsSource="{Binding TodayScreenshots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ActivityRecord}">
                                        <Border Background="#F1F1F3"
                                                BorderBrush="#D9D9DE"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Margin="3"
                                                Width="{Binding ElementName=ScreenshotsScroll, Path=Viewport, Converter={StaticResource ViewportToScreenshotSizeConverter}, ConverterParameter=Width}"
                                                Padding="0,0,0,6"
                                                ClipToBounds="True">
                                            <StackPanel Spacing="4">
                                                <Image Source="{Binding ScreenshotPath, Converter={StaticResource PathToBitmapConverter}}"
                                                       Height="{Binding ElementName=ScreenshotsScroll, Path=Viewport, Converter={StaticResource ViewportToScreenshotSizeConverter}, ConverterParameter=Height}"
                                                       Stretch="UniformToFill"/>
                                                <StackPanel Margin="6,0">
                                                    <TextBlock Text="{Binding StartTime, StringFormat='{}{0:HH:mm:ss}'}"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"/>
                                                    <TextBlock Text="{Binding AppNames}"
                                                               FontSize="8"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                    </Grid>
                </TabItem>

            </TabControl>


        </Grid>
    </Border>
</Window>
